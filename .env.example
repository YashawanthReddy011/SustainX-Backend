# Add your Atlas database user's password, then put the real URL in backend/.env.
# URL-encode reserved characters in the password.
DATABASE_URL="mongodb+srv://yashawanthareddyd_db_user:<db_password>@sustainxcluster.p2zlclb.mongodb.net/sustainx?retryWrites=true&w=majority"

# Set this to the exact frontend origin users open in their browser.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Use the same password for the local demo users created by npm run seed.
DEMO_ACCOUNT_PASSWORD=

# Choose Resend or SMTP for verification, password reset, and login-code emails.
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM="SustainX <your-address@example.com>"
# Gmail SMTP with an App Password (requires Google 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# These gate access to the existing COMMUNITY and ADMIN roles; they do not grant roles.
DASHBOARD_ACCESS_KEY=
ADMIN_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AUTH_EMAIL_API_URL=https://api.resend.com/emails

# Required in production: random secret with at least 32 characters.
JWT_SECRET=

# Set this to the number of trusted reverse-proxy hops in front of Express.
# Keep 0 when the API is exposed directly; configure it for accurate client IP rate limits behind a proxy.
TRUST_PROXY_HOPS=0
